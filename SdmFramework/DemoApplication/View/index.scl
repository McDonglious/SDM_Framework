@model Person

<html>
<head>
    <title>Person Detail</title>
    <link rel="stylesheet" href="/wwwroot/css/style.css">
</head>
<body>
    <nav>
        <a href="/Testcontroller/about">Detail</a>
        <a href="/Testcontroller/listing">Directory</a>
    </nav>
    <div class="container">
        <div class="page-header">
            <h1>@Model.Name</h1>
            <h2>@Model.JobTitle</h2>
        </div>
        <div class="card">
            <div class="card-grid">
                <div>
                    <p class="label">Email</p>
                    <p>@Model.Email</p>
                </div>
                <div>
                    <p class="label">Phone</p>
                    <p>@Model.PhoneNumber</p>
                </div>
                <div>
                    <p class="label">Department</p>
                    <p>@Model.Department</p>
                </div>
                <div>
                    <p class="label">Age</p>
                    <p>@Model.Age</p>
                </div>
            </div>
        </div>
    </div>
</body>
</html>